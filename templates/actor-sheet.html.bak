								<span class="cumul-arrow">&#9658;</span>
							</button>
							<div class="cumul-body">
								<div class="cumul-inner">
									<div class="cumul-meter-row">
										<meter class="cumul-meter" value="{{system.cumul_defi.value}}"
											min="{{system.cumul_defi.min}}" max="{{system.cumul_defi.max}}"></meter>
										<span class="cumul-frac">
											<input class="cumul-input" type="text" name="system.cumul_defi.value"
												value="{{system.cumul_defi.value}}" data-dtype="Number" />
											<span class="cumul-sep">/</span>
											<input class="cumul-input" type="text" name="system.cumul_defi.max"
												value="{{system.cumul_defi.max}}" data-dtype="Number" />
										</span>
									</div>
								</div>
							</div>
