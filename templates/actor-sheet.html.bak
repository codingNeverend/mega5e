			{{!-- Combat Tab --}}
			<div class="tab attributes" data-group="primary" data-tab="combat">
				<div class="bandeau_combat">
					<div style="width:450px;">
						<table class="equipement" style="width:450px;">
							<thead style="border:none;">
								<th align="center" colspan="9">
									<div class="score-breakdown-row"
										style="border-radius:10px;padding:10px 16px;border:1px solid rgba(220,60,60,0.3);display:flex;align-items:center;flex-wrap:wrap;gap:10px;justify-content:center;">
										<div style="display:flex;flex-direction:column;align-items:center;gap:5px;">
											<span
												style="font-size:0.92em;color:#FFF;text-transform:uppercase;letter-spacing:0.08em;"><i
													class="fas fa-crosshairs"
													style="margin-right:3px;"></i>COMBAT</span>
											{{#if system.verouille}}<span
												style="display:inline-block;color:#fcd8d8;border-radius:20px;padding:4px 12px;font-weight:bold;font-size:0.95em;box-shadow:0 2px 8px rgba(0,0,0,0.5);border:1.5px solid rgba(220,80,80,0.6);letter-spacing:0.05em;">d{{system.domaines.combat.value}}</span>{{else}}<span
												style="display:inline-flex;align-items:center;background:rgba(220,60,60,0.18);border:1.5px solid rgba(220,60,60,0.55);border-radius:20px;padding:4px 14px;gap:6px;">
												d<input class="comb" type="text" name="system.domaines.combat.value"
													value="{{system.domaines.combat.value}}" data-dtype="Number"
													style="background:transparent;border:none;color:#f5a0a0;font-weight:bold;font-size:1.12em;text-align:center;width:36px;outline:none;" />
												<span style="color:#fff;font-size:0.82em;font-weight:600;"></span>
											</span>{{/if}}
										</div>
										<span style="color:#fff;font-size:1.15em;"><i class="fas fa-plus"></i></span>
										<div style="display:flex;flex-direction:column;align-items:center;gap:5px;">
											<span
												style="font-size:0.92em;color:#FFF;text-transform:uppercase;letter-spacing:0.08em;"><i
													class="fas fa-sliders" style="margin-right:3px;"></i>Bonus /
												Malus</span>
											{{#if system.combat_modif.value}}<span
												style="display:inline-flex;align-items:center;background:rgba(220,50,50,0.22);border:1.5px solid rgba(220,80,80,0.75);border-radius:20px;padding:4px 14px;gap:6px;"><input
													class="comb bonus_combat" type="text"
													name="system.combat_modif.value"
													value="{{system.combat_modif.value}}" data-dtype="Number"
													style="background:transparent;border:none;color:#fff;font-weight:bold;font-size:1.12em;text-align:center;width:36px;outline:none;" /><span
													style="color:#fcd8d8;font-size:0.82em;">Rg</span></span>{{else}}<span
												style="display:inline-flex;align-items:center;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);border-radius:20px;padding:4px 14px;gap:6px;"><input
													class="comb" type="text" name="system.combat_modif.value"
													value="{{system.combat_modif.value}}" data-dtype="Number"
													style="background:transparent;border:none;color:#ccc;font-weight:bold;font-size:1.12em;text-align:center;width:36px;outline:none;" /><span
													style="color:#fff;font-size:0.82em;">Rg</span></span>{{/if}}
										</div>
										<span
											style="color:#fff;font-size:1.5em;font-weight:bold;line-height:1;">=</span>
										<div style="display:flex;flex-direction:column;align-items:center;gap:5px;">
											<span
												style="font-size:0.92em;color:#FFF;text-transform:uppercase;letter-spacing:0.08em;"><i
													class="fas fa-trophy" style="margin-right:3px;"></i>Total
												COMBAT</span>
											<span
												style="display:inline-block;color:#fcd8d8;border-radius:20px;padding:6px 22px;font-weight:bold;font-size:1.2em;box-shadow:0 3px 12px rgba(0,0,0,0.6);border:1.5px solid rgba(220,80,80,0.6);letter-spacing:0.05em;">d{{add
												system.domaines.combat.value system.combat_modif.value}} <span
													style="font-size:0.72em;opacity:0.85;"></span></span>
										</div>
									</div>
								</th>
							</thead>

							<tr
								style="background:rgba(0,0,0,0.45);border-top:2px solid rgba(190,50,50,0.4);border-bottom:2px solid rgba(190,50,50,0.4);">
								<td colspan="4" style="text-align:center;padding:5px 4px;">
									<span class="combat_rollable" data-type="{{system.derives.initiative.label}}"
										value="{{system.derives.initiative.value}}"
										style="color:#ccc;font-weight:700;font-size:0.9em;letter-spacing:0.05em;"><i
											class="fas fa-bolt" style="margin-right:4px;"></i>Init.</span>
									<span style="color:#ccc;font-size:0.9em;">{{system.derives.initiative.jet}}</span>
									<span style="color:#aaa;font-size:0.85em;"><i class="fas fa-plus-circle"
											style="margin:0 3px;"></i>{{#if system.bonus_initiative.value}}<input
											class="comb" type="text" name="system.bonus_initiative.value"
											value="{{system.bonus_initiative.value}}" data-dtype="Number"
											style="background:rgba(255,160,0,0.25);border:1px solid rgba(255,160,0,0.6);border-radius:8px;color:#ffcc66;font-weight:bold;width:32px;text-align:center;">{{else}}<input
											class="comb" type="text" name="system.bonus_initiative.value"
											value="{{system.bonus_initiative.value}}" data-dtype="Number"
											style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.18);border-radius:8px;color:#ccc;width:32px;text-align:center;">{{/if}}</span>
								</td>
								<td colspan="5" style="text-align:center;padding:5px 4px;">
									<span class="combat_rollable" data-type="{{system.derives.esquive.label}}"
										value="{{system.derives.esquive.value}}"
										style="color:#ccc;font-weight:700;font-size:0.9em;letter-spacing:0.05em;"><i
											class="fas fa-person-running" style="margin-right:4px;"></i>Esq.</span>
									<span style="color:#ccc;font-size:0.9em;">{{system.derives.esquive.jet}}</span>
									<span style="color:#aaa;font-size:0.85em;"><i class="fas fa-plus-circle"
											style="margin:0 3px;"></i>{{#if system.bonus_esquive.value}}<input
											class="comb" type="text" name="system.bonus_esquive.value"
											value="{{system.bonus_esquive.value}}" data-dtype="Number"
