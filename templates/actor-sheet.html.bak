											placeholder="............................................................................................................................................................................" />
									</div>{{/if}}</td>
								<td align="center">+<input {{#if system.verouille}}disabled="disabled" {{/if}}
										class="comb" type="text" name="system.rg_spe_3.value"
										value="{{system.rg_spe_3.value}}" data-dtype="Number" /></td>
							</tr>
							<tr>
						</table>
						{{/if}}
					</div>
				</div>
			</div>

		</section>


	</div>

	{{!-- Invisible trigger zone for side tabs --}}
	<div class="side-trigger-zone"></div>

	{{!-- Side Tab Navigation - outside the main content --}}
	<nav class="side-tabs" data-group="primary">
		<a class="side-tab-item" data-tab="description" title="DESCRIPTION">
			<i class="fas fa-user"></i>
		</a>
		<a class="side-tab-item" data-tab="attributes" title="ATTRIBUTS">
			<i class="fas fa-chart-bar"></i>
		</a>
		<a class="side-tab-item" data-tab="combat" title="COMBAT">
			<i class="fas fa-sword"></i>
		</a>
		<a class="side-tab-item" data-tab="items" title="INVENTAIRE">
			<i class="fas fa-backpack"></i>
		</a>
		{{#if GM}}<a class="side-tab-item" data-tab="MJ" title="MJ">
			<i class="fas fa-eye"></i>
		</a>{{/if}}
	</nav>

</form>