<form class="{{cssClass}} {{actor.type}}" autocomplete="off">
	<style>
		.container {
			display: flex;
		}

		.column1 {
			width: 60%;
			padding: 10px;

		}

		.column2 {
			width: 40%;
			padding: 10px;

		}
	</style>

	{{!-- Sheet Header --}}
	<header class="sheet-header">
		<div class="header-fields">
			<div class="hf-flex">
				{{!-- Portrait --}}
				<div class="hf-portrait">
					<span class="actor-view" value="{{actor.img}}">
						<img src="{{actor.img}}" data-edit="img" title="{{actor.name}}"
							class="img hf-portrait-img{{#if system.combat_modif.value}} hf-combat{{/if}}" />
					</span>
				</div>
				{{!-- Identit� : Nom + Voie/Sph�re --}}
				<div class="hf-identity">
					<div class="hf-name">
						<span class="charname">
							<input {{#if system.verouille}}disabled="disabled" {{/if}} name="name" type="text"
								value="{{actor.name}}" placeholder="Nom" />
						</span>
						<span class="verouille hf-lock-btn" value="{{system.verouille}}"
							title="Verrouiller / D�verrouiller la fiche">
							{{#if system.verouille}}<i class="fas fa-lock"></i>{{else}}<i
								class="fas fa-lock-open"></i>{{/if}}
						</span>
					</div>
					<div class="hf-meta">
						{{#ifequal system.type_acteur "MEGA"}}
						<span class="hf-meta-field hf-voie">
							<i class="fas fa-compass hf-meta-icon"></i>
							{{#unless system.verouille}}
							<input class="comb2 autoselect" list="voie_pj" type="text" id="choix_voie"
								name="system.voie.value" value="{{system.voie.value}}" placeholder="Voie">
							<datalist id="voie_pj">
								<option value="Biocyb">
								<option value="Conceptech">
								<option value="Escorteur">
								<option value="Fouineur">
								<option value="M�dian">
								<option value="Ethnoranger">
								<option value="Patrouilleur">
								<option value="Sensit">
							</datalist>
							{{else}}
							<input name="system.voie.value" readonly type="text" value="{{system.voie.value}}">
							{{/unless}}
						</span>
						<span class="hf-meta-field hf-sphere">
							<i class="fas fa-atom hf-meta-icon"></i>
							<input name="system.sphere.value" readonly type="text" value="{{system.sphere.value}}">
						</span>
						{{#if system.sphere2.value}}
						<span class="hf-meta-field hf-sphere2">
							<i class="fas fa-atom hf-meta-icon"></i>
							<input name="system.sphere2.value" readonly type="text" value="{{system.sphere2.value}}">
						</span>
						{{/if}}
						{{else}}
						<span class="hf-meta-field hf-metier">
							<i class="fas fa-briefcase hf-meta-icon"></i>
							{{#unless system.verouille}}
							<input class="autoselect" list="voie_pj2" type="text" id="choix_voie"
								name="system.voie.value" value="{{system.voie.value}}" placeholder="M�tier">
							<datalist id="voie_pj2">
								<option value="Soignant">
								<option value="Homme d'affaire">
								<option value="Chauffeur, pilote">
								<option value="Eccl�siastique">
								<option value="Clerc, notaire">
								<option value="Intendant, conn�table">
								<option value="Artisan">
								<option value="Moine guerrier">
								<option value="Chevalier">
								<option value="Artiste">
								<option value="Militaire, milicien, policier">
								<option value="Agent de s�curit�, garde du corps">
								<option value="Infiltrateur">
							</datalist>
							{{else}}
							<input name="system.voie.value" readonly type="text" value="{{system.voie.value}}">
							{{/unless}}
						</span>
						<span class="hf-meta-field hf-sphere">
							<i class="fas fa-atom hf-meta-icon"></i>
							<input name="system.sphere.value" readonly type="text" value="{{system.sphere.value}}">
						</span>
						{{#if system.sphere2.value}}
						<span class="hf-meta-field hf-sphere2">
							<i class="fas fa-atom hf-meta-icon"></i>
							<input name="system.sphere2.value" readonly type="text" value="{{system.sphere2.value}}">
						</span>
						{{/if}}
						{{/ifequal}}
					</div>
				</div>
				{{!-- Ressources : VIE et M�L�E --}}
				<div class="hf-resources">
					<div class="modern-health-triangle" title="Points de Vie">
						<div class="triangle-icon health-icon">
							<i class="fas fa-plus-circle"
								style="color: {{#ifinferior system.health.value 5}}#e74c3c{{else}}#27ae60{{/ifinferior}};"></i>
						</div>
						<div class="resource-values">
							<input type="text" class="modern-resource-input health-current" name="system.health.value"
								value="{{system.health.value}}" data-dtype="Number" {{#ifinferior system.health.value
								5}}style="color: #e74c3c; font-weight: bold;" {{/ifinferior}} />
							<span class="resource-separator">/</span>
							<input class="modern-resource-input health-max" {{#if system.verouille}}disabled="disabled"
								{{/if}} type="text" name="system.health.max" value="{{system.health.max}}"
								data-dtype="Number" />
						</div>
						<div class="resource-label">VIE</div>
					</div>
					<div class="modern-melee-triangle" title="Points de M�L�E">
						<div class="triangle-icon melee-icon">
							<i class="fas fa-sword"
								style="color: {{#ifinferior system.power.value 5}}#e74c3c{{else}}#3498db{{/ifinferior}};"></i>
						</div>
						<div class="resource-values">
							<input class="modern-resource-input melee-current" type="text" name="system.power.value"
								value="{{system.power.value}}" data-dtype="Number" {{#ifinferior system.power.value
								5}}style="color: #e74c3c; font-weight: bold;" {{/ifinferior}} />
							<span class="resource-separator">/</span>
							<input type="text" name="system.power.max" {{#if system.verouille}}disabled="disabled"
								{{/if}} class="modern-resource-input melee-max" value="{{system.power.max}}"
								data-dtype="Number" />
						</div>
						<div class="resource-label">M�L�E</div>
					</div>
				</div>
			</div>
	</header>

	{{!-- Main Content Area with Side Navigation --}}
	<div class="main-content">
		{{!-- Sheet Body --}}
		<section class="sheet-body">

			{{!-- Biography Tab --}}
			<div class="tab biography" data-group="primary" data-tab="description">
				<div class="desc-bandeau">
					<div class="desc-top-row">
						<div class="desc-col-main">
							{{!-- Panel Identit� --}}
							<div class="desc-panel-outer desc-panel-outer--stretch">
								<div class="desc-panel-label desc-panel-label--identite">IDENTIT�</div>
								<div class="desc-panel">
									<div class="desc-panel-body">
										<div class="desc-fields-grid">
											<div class="desc-field">
												<label class="desc-field-label"><i class="fas fa-mask"></i>
													Surnom/Pseudo</label>
												<input {{#if system.verouille}}disabled="disabled" {{/if}} type="text"
													class="desc-field-input" name="system.pseudo"
													value="{{system.pseudo}}" placeholder="Surnom du personnage" />
											</div>
											<div class="desc-field">
												<label class="desc-field-label"><i class="fas fa-seedling"></i> Attitude
													/ V�cu</label>
												<input {{#if system.verouille}}disabled="disabled" {{/if}} type="text"
													class="desc-field-input" name="system.vecu" value="{{system.vecu}}"
													placeholder="Origines, attitude g�n�rale" />
											</div>
										</div>
										<div class="desc-fields-grid desc-fields-grid--4col">
											<div class="desc-field">
												<label class="desc-field-label"><i class="fas fa-id-card"></i> Identit�
													provisoire</label>
												<input {{#if system.verouille}}disabled="disabled" {{/if}} type="text"
													class="desc-field-input" name="system.identite_provisoire"
													value="{{system.identite_provisoire}}"
													placeholder="Alias ou couverture" />
											</div>
											<div class="desc-field">
												<label class="desc-field-label"><i class="fas fa-birthday-cake"></i>
													�ge</label>
												<input {{#if system.verouille}}disabled="disabled" {{/if}} type="text"
													class="desc-field-input" name="system.age" value="{{system.age}}"
													placeholder="30 ans" />
											</div>
											<div class="desc-field">
												<label class="desc-field-label"><i class="fas fa-weight"></i>
													Poids</label>
												<input {{#if system.verouille}}disabled="disabled" {{/if}} type="text"
													class="desc-field-input" name="system.poids"
													value="{{system.poids}}" placeholder="75 kg" />
											</div>
											<div class="desc-field">
												<label class="desc-field-label"><i class="fas fa-ruler-vertical"></i>
													Taille</label>
												<input {{#if system.verouille}}disabled="disabled" {{/if}} type="text"
													class="desc-field-input" name="system.taille"
													value="{{system.taille}}" placeholder="1m80" />
											</div>
										</div>
										<div class="desc-fields-grid">
											<div class="desc-field">
												<label class="desc-field-label"><i class="fas fa-map-marker-alt"></i>
													Origine</label>
												<input {{#if system.verouille}}disabled="disabled" {{/if}} type="text"
													class="desc-field-input" name="system.origine"
													value="{{system.origine}}" placeholder="Monde, ville, milieu" />
											</div>
											<div class="desc-field">
												<label class="desc-field-label"><i class="fas fa-comments"></i> Langues
													parl�es</label>
												<input {{#if system.verouille}}disabled="disabled" {{/if}} type="text"
													class="desc-field-input" name="system.langues"
													value="{{system.langues}}" placeholder="Ex : Fran�ais, Anglais" />
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="desc-col-sphere">
							<div class="desc-panel-outer desc-panel-outer--stretch">
								<div class="desc-panel-label desc-panel-label--sphere">SPH�RE</div>
								<div class="desc-panel desc-panel--sphere">
									<div class="desc-panel-body desc-panel-body--sphere">
										<aside class="desc-sphere-col{{#if system.verouille}} sphere-locked{{/if}}">
											<div class="sphere-star-container">
												<svg class="sphere-star-svg" viewBox="0 0 300 265"
													xmlns="http://www.w3.org/2000/svg">
													<defs>
														<filter id="sph-glow" x="-60%" y="-60%" width="220%"
															height="220%">
															<feGaussianBlur stdDeviation="4" result="blur" />
															<feMerge>
																<feMergeNode in="blur" />
																<feMergeNode in="SourceGraphic" />
															</feMerge>
														</filter>
														<radialGradient id="grad-rel" cx="50%" cy="50%" r="50%">
															<stop offset="0%" stop-color="#c4b5fd"
																stop-opacity="0.95" />
															<stop offset="70%" stop-color="#7c3aed"
																stop-opacity="0.50" />
															<stop offset="100%" stop-color="#7c3aed" stop-opacity="0" />
														</radialGradient>
														<radialGradient id="grad-inv" cx="50%" cy="50%" r="50%">
															<stop offset="0%" stop-color="#fde68a"
																stop-opacity="0.95" />
															<stop offset="70%" stop-color="#d97706"
																stop-opacity="0.50" />
															<stop offset="100%" stop-color="#d97706" stop-opacity="0" />
														</radialGradient>
														<radialGradient id="grad-viv" cx="50%" cy="50%" r="50%">
															<stop offset="0%" stop-color="#6ee7b7"
																stop-opacity="0.95" />
															<stop offset="70%" stop-color="#059669"
																stop-opacity="0.50" />
															<stop offset="100%" stop-color="#059669" stop-opacity="0" />
														</radialGradient>
														<radialGradient id="grad-log" cx="50%" cy="50%" r="50%">
															<stop offset="0%" stop-color="#93c5fd"
																stop-opacity="0.95" />
															<stop offset="70%" stop-color="#1d4ed8"
																stop-opacity="0.50" />
															<stop offset="100%" stop-color="#1d4ed8" stop-opacity="0" />
														</radialGradient>
														<radialGradient id="grad-mat" cx="50%" cy="50%" r="50%">
															<stop offset="0%" stop-color="#fca5a5"
																stop-opacity="0.95" />
															<stop offset="70%" stop-color="#dc2626"
																stop-opacity="0.50" />
															<stop offset="100%" stop-color="#dc2626" stop-opacity="0" />
														</radialGradient>
													</defs>

													<!-- Fond etoile - classe sph-bg pour couleur adaptative dark/light -->
													<polygon class="sph-bg sph-bg--star"
														points="150,55 170,117 236,117 183,156 203,218 150,179 97,218 117,156 64,117 130,117" />
													<polygon class="sph-bg sph-bg--inner"
														points="170,117 183,156 150,179 117,156 130,117" />
													<line class="sph-bg sph-bg--line" x1="150" y1="55" x2="183"
														y2="156" />
													<line class="sph-bg sph-bg--line" x1="150" y1="55" x2="117"
														y2="156" />
													<line class="sph-bg sph-bg--line" x1="236" y1="117" x2="97"
														y2="218" />
													<line class="sph-bg sph-bg--line" x1="236" y1="117" x2="150"
														y2="179" />
													<line class="sph-bg sph-bg--line" x1="203" y1="218" x2="64"
														y2="117" />
													<!-- Label central -->
													<text class="sph-bg sph-bg--center-label" x="150" y="145"
														text-anchor="middle" font-family="sans-serif" font-size="14"
														font-weight="600" letter-spacing="0.18em">SPH&#200;RE</text>

													<!-- RELATIONS (haut) - label AU-DESSUS -->
													<g class="sphere-pt sphere-pt--rel" data-sphere="Relations"
														style="cursor:pointer;">
														<circle class="sphere-pt-halo" cx="150" cy="55" r="20"
															fill="url(#grad-rel)" opacity="0" filter="url(#sph-glow)" />
														<circle class="sphere-pt-hit" cx="150" cy="55" r="24"
															fill="transparent" />
														<circle class="sphere-pt-ring" cx="150" cy="55" r="14"
															fill="none" stroke="#a78bfa" stroke-width="1.8"
															opacity="0.40" />
														<circle class="sphere-pt-dot" cx="150" cy="55" r="6"
															fill="#a78bfa" opacity="0.70" />
														<text x="150" y="28" text-anchor="middle"
															font-family="sans-serif" font-size="17" font-weight="700"
															letter-spacing="0.04em" fill="#c4b5fd"
															class="sphere-pt-label" opacity="0.75">RELATIONS</text>
														<text class="sphere-badge sphere-badge--s1" x="150" y="60"
															text-anchor="middle" font-family="sans-serif" font-size="16"
															font-weight="900" fill="white" visibility="hidden">1</text>
														<text class="sphere-badge sphere-badge--s2" x="150" y="60"
															text-anchor="middle" font-family="sans-serif" font-size="16"
															font-weight="900" fill="white" visibility="hidden">2</text>
													</g>

													<!-- INVISIBLE (haut-droite) - label SOUS le point -->
													<g class="sphere-pt sphere-pt--inv" data-sphere="Invisible"
														style="cursor:pointer;">
														<circle class="sphere-pt-halo" cx="236" cy="117" r="20"
															fill="url(#grad-inv)" opacity="0" filter="url(#sph-glow)" />
														<circle class="sphere-pt-hit" cx="236" cy="117" r="24"
															fill="transparent" />
														<circle class="sphere-pt-ring" cx="236" cy="117" r="14"
															fill="none" stroke="#fbbf24" stroke-width="1.8"
															opacity="0.40" />
														<circle class="sphere-pt-dot" cx="236" cy="117" r="6"
															fill="#fbbf24" opacity="0.70" />
														<text x="236" y="148" text-anchor="middle"
															font-family="sans-serif" font-size="17" font-weight="700"
															letter-spacing="0.04em" fill="#fde68a"
															class="sphere-pt-label" opacity="0.75">INVISIBLE</text>
														<text class="sphere-badge sphere-badge--s1" x="236" y="122"
															text-anchor="middle" font-family="sans-serif" font-size="16"
															font-weight="900" fill="white" visibility="hidden">1</text>
														<text class="sphere-badge sphere-badge--s2" x="236" y="122"
															text-anchor="middle" font-family="sans-serif" font-size="16"
															font-weight="900" fill="white" visibility="hidden">2</text>
													</g>

													<!-- VIVANT (bas-droite) - label EN-DESSOUS -->
													<g class="sphere-pt sphere-pt--viv" data-sphere="Vivant"
														style="cursor:pointer;">
														<circle class="sphere-pt-halo" cx="203" cy="218" r="20"
															fill="url(#grad-viv)" opacity="0" filter="url(#sph-glow)" />
														<circle class="sphere-pt-hit" cx="203" cy="218" r="24"
															fill="transparent" />
														<circle class="sphere-pt-ring" cx="203" cy="218" r="14"
															fill="none" stroke="#34d399" stroke-width="1.8"
															opacity="0.40" />
														<circle class="sphere-pt-dot" cx="203" cy="218" r="6"
															fill="#34d399" opacity="0.70" />
														<text x="203" y="248" text-anchor="middle"
															font-family="sans-serif" font-size="17" font-weight="700"
															letter-spacing="0.04em" fill="#6ee7b7"
															class="sphere-pt-label" opacity="0.75">VIVANT</text>
														<text class="sphere-badge sphere-badge--s1" x="203" y="223"
															text-anchor="middle" font-family="sans-serif" font-size="16"
															font-weight="900" fill="white" visibility="hidden">1</text>
														<text class="sphere-badge sphere-badge--s2" x="203" y="223"
															text-anchor="middle" font-family="sans-serif" font-size="16"
															font-weight="900" fill="white" visibility="hidden">2</text>
													</g>

													<!-- LOGIQUE (bas-gauche) - label EN-DESSOUS -->
													<g class="sphere-pt sphere-pt--log" data-sphere="Logique"
														style="cursor:pointer;">
														<circle class="sphere-pt-halo" cx="97" cy="218" r="20"
															fill="url(#grad-log)" opacity="0" filter="url(#sph-glow)" />
														<circle class="sphere-pt-hit" cx="97" cy="218" r="24"
															fill="transparent" />
														<circle class="sphere-pt-ring" cx="97" cy="218" r="14"
															fill="none" stroke="#60a5fa" stroke-width="1.8"
															opacity="0.40" />
														<circle class="sphere-pt-dot" cx="97" cy="218" r="6"
															fill="#60a5fa" opacity="0.70" />
														<text x="97" y="248" text-anchor="middle"
															font-family="sans-serif" font-size="17" font-weight="700"
															letter-spacing="0.04em" fill="#93c5fd"
															class="sphere-pt-label" opacity="0.75">LOGIQUE</text>
														<text class="sphere-badge sphere-badge--s1" x="97" y="223"
															text-anchor="middle" font-family="sans-serif" font-size="16"
															font-weight="900" fill="white" visibility="hidden">1</text>
														<text class="sphere-badge sphere-badge--s2" x="97" y="223"
															text-anchor="middle" font-family="sans-serif" font-size="16"
															font-weight="900" fill="white" visibility="hidden">2</text>
													</g>

													<!-- MATIERE (haut-gauche) - label SOUS le point -->
													<g class="sphere-pt sphere-pt--mat" data-sphere="Mati&#232;re"
														style="cursor:pointer;">
														<circle class="sphere-pt-halo" cx="64" cy="117" r="20"
															fill="url(#grad-mat)" opacity="0" filter="url(#sph-glow)" />
														<circle class="sphere-pt-hit" cx="64" cy="117" r="24"
															fill="transparent" />
														<circle class="sphere-pt-ring" cx="64" cy="117" r="14"
															fill="none" stroke="#f87171" stroke-width="1.8"
															opacity="0.40" />
														<circle class="sphere-pt-dot" cx="64" cy="117" r="6"
															fill="#f87171" opacity="0.70" />
														<text x="64" y="148" text-anchor="middle"
															font-family="sans-serif" font-size="17" font-weight="700"
															letter-spacing="0.04em" fill="#fca5a5"
															class="sphere-pt-label" opacity="0.75">MATI&#200;RE</text>
														<text class="sphere-badge sphere-badge--s1" x="64" y="122"
															text-anchor="middle" font-family="sans-serif" font-size="16"
															font-weight="900" fill="white" visibility="hidden">1</text>
														<text class="sphere-badge sphere-badge--s2" x="64" y="122"
															text-anchor="middle" font-family="sans-serif" font-size="16"
															font-weight="900" fill="white" visibility="hidden">2</text>
													</g>
												</svg>
											</div>
										</aside>
									</div>
								</div>
							</div>
						</div>
					</div>
					{{!-- Panel Fondamentaux pleine largeur --}}
					<div class="desc-panel-outer">
						<div class="desc-panel-label desc-panel-label--fondamentaux">FONDAMENTAUX</div>
						<div class="desc-panel">
							<div class="desc-panel-body">
								<div class="desc-fields-grid">
									<div class="desc-field desc-field--motivation">
										<label class="desc-field-label"><i class="fas fa-star"></i> Motivation</label>
										<textarea {{#if system.verouille}}disabled="disabled" {{/if}}
											class="desc-field-textarea" name="system.motivation"
											placeholder="Ce qui pousse le personnage � agir">{{system.motivation}}</textarea>
									</div>
									<div class="desc-field desc-field--objectifs">
										<label class="desc-field-label"><i class="fas fa-bullseye"></i>
											Objectifs</label>
										<textarea {{#if system.verouille}}disabled="disabled" {{/if}}
											class="desc-field-textarea" name="system.objectifs"
											placeholder="Buts � court et long terme">{{system.objectifs}}</textarea>
									</div>
									<div class="desc-field desc-field--pulsions">
