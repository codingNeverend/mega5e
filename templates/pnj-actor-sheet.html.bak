							<tfoot>
								<tr></tr>
								<td align="center" colspan="10">H Handicaper, A Assommer, S Sonner, R Renverser, I
									Immobiliser, V Vitesse<br>P Positionnement, T Tenir à distance, D Défaut de la
									cuirasse<span class="info_effets_speciaux" value="">&nbsp<img class="icon_info"
											src="systems/mega/images/info.svg"></span></td>
								</tr>
							</tfoot>
						</table>

					</div>
					<div>
						<table class="protections" style="width:100%;border-collapse:collapse;">
							<!-- Ligne Base DEF -->
							<tr style="background:#1e6080;position:relative;">
								<td colspan="9" style="text-align:center;padding:6px 16px;">
									<span class="masquer_combat"
										style="position:absolute;top:6px;right:8px;cursor:pointer;opacity:0.6;font-size:0.9em;"><i
											class="fa fa-expand" aria-hidden="true"></i></span>
									<div
										style="display:flex;align-items:center;flex-wrap:nowrap;gap:8px;justify-content:center;">
										<div style="display:flex;flex-direction:column;align-items:center;gap:5px;">
											<span
												style="font-size:0.78em;text-transform:uppercase;letter-spacing:0.08em;"><i
													class="fas fa-shield-halved" style="margin-right:3px;"></i>Base
												DEF</span>
											<span
												style="display:inline-block;background:linear-gradient(135deg,#1a4f6eee,#0d3248cc);color:#c0e8ff;border-radius:20px;padding:5px 16px;font-weight:bold;font-size:1.12em;box-shadow:0 2px 8px rgba(0,0,0,0.55);border:1.5px solid rgba(91,168,212,0.55);">Niv.
												{{system.def.value}}</span>
										</div>
										<span style="color:rgba(91,168,212,0.45);font-size:1.15em;"><i
												class="fas fa-plus"></i></span>
										<div style="display:flex;flex-direction:column;align-items:center;gap:5px;">
											<span
												style="font-size:0.78em;color:#aaa;text-transform:uppercase;letter-spacing:0.08em;"><i
													class="fas fa-sliders" style="margin-right:3px;"></i>Bonus /
												Malus</span>
											{{#if system.def_modif.value}}<span
												style="display:inline-flex;align-items:center;background:rgba(220,50,50,0.22);border:1.5px solid rgba(220,80,80,0.75);border-radius:20px;padding:4px 14px;"><input
													class="comb" type="text" name="system.def_modif.value"
													value="{{system.def_modif.value}}" data-dtype="Number"
													style="background:transparent;border:none;color:#ff8888;font-weight:bold;font-size:1.12em;text-align:center;width:36px;outline:none;" /></span>{{else}}<span
												style="display:inline-flex;align-items:center;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);border-radius:20px;padding:4px 14px;"><input
													class="comb" type="text" name="system.def_modif.value"
													value="{{system.def_modif.value}}" data-dtype="Number"
													style="background:transparent;border:none;color:#ccc;font-weight:bold;font-size:1.12em;text-align:center;width:36px;outline:none;" /></span>{{/if}}
										</div>
										<span style="color:rgba(91,168,212,0.45);font-size:1.15em;"><i
												class="fas fa-plus"></i></span>
										<div style="display:flex;flex-direction:column;align-items:center;gap:5px;">
											<span
												style="font-size:0.78em;color:#7ec8f0;text-transform:uppercase;letter-spacing:0.08em;"><i
													class="fas fa-vest" style="margin-right:3px;"></i>DEF
												Protections</span>
											<span
												style="display:inline-block;background:linear-gradient(135deg,#1a4f6eee,#0d3248cc);color:#c0e8ff;border-radius:20px;padding:5px 16px;font-weight:bold;font-size:1.12em;box-shadow:0 2px 8px rgba(0,0,0,0.55);border:1.5px solid rgba(91,168,212,0.45);">{{def_prot_total}}</span>
										</div>
										<span
											style="color:#5ba8d4;font-size:1.5em;font-weight:bold;line-height:1;">=</span>
										<div style="display:flex;flex-direction:column;align-items:center;gap:5px;">
											<span
												style="font-size:0.78em;color:#7ec8f0;text-transform:uppercase;letter-spacing:0.08em;"><i
													class="fas fa-shield-check" style="margin-right:3px;"></i>Total
												DEF</span>
											<span
												style="display:inline-block;background:linear-gradient(135deg,#1a5f84ee,#0e3d5acc);color:#d0f0ff;border-radius:20px;padding:6px 22px;font-weight:bold;font-size:1.2em;box-shadow:0 3px 12px rgba(0,0,0,0.6);border:1.5px solid rgba(91,168,212,0.65);letter-spacing:0.05em;">Niv.
												{{add (add system.def.value system.def_modif.value)
												def_prot_total}}</span>
										</div>
									</div>
								</td>
							</tr>
							{{#unless system.reduit}}
							<!-- En-tête icônes protection -->
							<tr>
								<td colspan="2"
									style="text-align:right;background:rgba(0,0,0,0.35);border-top:2px solid rgba(255,255,255,0.15);border-bottom:1px solid rgba(255,255,255,0.08);padding:4px 8px;">
									<span
										style="color:#c8d8e8;font-size:0.75em;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;"><i
											class="fas fa-vest"
											style="margin-right:5px;color:#7ec8f0;"></i>Protection</span>
								</td>
								<td
									style="text-align:center;padding:4px 2px;background:rgba(230,126,34,0.22);border-top:2px solid rgba(255,255,255,0.15);border-bottom:1px solid rgba(255,255,255,0.08);">
									<img src="systems/mega/images/flint-spark.svg"
										style="width:18px;height:18px;display:block;margin:0 auto 2px;filter:drop-shadow(0 1px 3px rgba(0,0,0,0.7));" /><span
										style="font-size:0.68em;color:#111;font-weight:bold;letter-spacing:0.05em;">CHOC</span>
								</td>
								<td
									style="text-align:center;padding:4px 2px;background:rgba(176,190,197,0.18);border-top:2px solid rgba(255,255,255,0.15);border-bottom:1px solid rgba(255,255,255,0.08);">
									<img src="systems/mega/images/blade-fall.svg"
										style="width:18px;height:18px;display:block;margin:0 auto 2px;filter:drop-shadow(0 1px 3px rgba(0,0,0,0.7));" /><span
										style="font-size:0.68em;color:#111;font-weight:bold;letter-spacing:0.05em;">LAME</span>
								</td>
								<td
									style="text-align:center;padding:4px 2px;background:rgba(41,128,185,0.22);border-top:2px solid rgba(255,255,255,0.15);border-bottom:1px solid rgba(255,255,255,0.08);">
									<img src="systems/mega/images/silver-bullet.svg"
										style="width:18px;height:18px;display:block;margin:0 auto 2px;filter:drop-shadow(0 1px 3px rgba(0,0,0,0.7));" /><span
										style="font-size:0.68em;color:#111;font-weight:bold;letter-spacing:0.05em;">BALLE</span>
								</td>
								<td
									style="text-align:center;padding:4px 2px;background:rgba(231,76,60,0.22);border-top:2px solid rgba(255,255,255,0.15);border-bottom:1px solid rgba(255,255,255,0.08);">
									<img src="systems/mega/images/fire.svg"
										style="width:18px;height:18px;display:block;margin:0 auto 2px;filter:drop-shadow(0 1px 3px rgba(0,0,0,0.7));" /><span
										style="font-size:0.68em;color:#111;font-weight:bold;letter-spacing:0.05em;">FEU</span>
								</td>
								<td
									style="text-align:center;padding:4px 2px;background:rgba(93,173,226,0.22);border-top:2px solid rgba(255,255,255,0.15);border-bottom:1px solid rgba(255,255,255,0.08);">
									<img src="systems/mega/images/frozen-orb.svg"
										style="width:18px;height:18px;display:block;margin:0 auto 2px;filter:drop-shadow(0 1px 3px rgba(0,0,0,0.7));" /><span
										style="font-size:0.68em;color:#111;font-weight:bold;letter-spacing:0.05em;">FROID</span>
								</td>
								<td
									style="text-align:center;padding:4px 2px;background:rgba(46,204,113,0.22);border-top:2px solid rgba(255,255,255,0.15);border-bottom:1px solid rgba(255,255,255,0.08);">
									<img src="systems/mega/images/chemical-drop.svg"
										style="width:18px;height:18px;display:block;margin:0 auto 2px;filter:drop-shadow(0 1px 3px rgba(0,0,0,0.7));" /><span
										style="font-size:0.68em;color:#111;font-weight:bold;letter-spacing:0.05em;">ACIDE</span>
								</td>
								<td
									style="text-align:center;padding:4px 2px;background:rgba(155,89,182,0.22);border-top:2px solid rgba(255,255,255,0.15);border-bottom:1px solid rgba(255,255,255,0.08);">
									<img src="systems/mega/images/ringed-beam.svg"
										style="width:18px;height:18px;display:block;margin:0 auto 2px;filter:drop-shadow(0 1px 3px rgba(0,0,0,0.7));" /><span
										style="font-size:0.68em;color:#111;font-weight:bold;letter-spacing:0.05em;">RAYON</span>
								</td>
							</tr>
							<!-- DEF réelle -->
							<tr>
								<td colspan="2"
									style="text-align:right;background:rgba(0,0,0,0.35);border-bottom:2px solid rgba(255,255,255,0.15);padding:4px 8px;">
									<span style="color:#e8f4ff;font-size:0.8em;font-weight:700;"><i
											class="fas fa-shield-halved" style="margin-right:5px;color:#7ec8f0;"></i>DEF
										réelle</span><button type="button" class="btn-defense-localisation"
										title="Voir la défense par localisation" style="margin-left:4px;"><i
											class="fas fa-person"></i></button>
								</td>
								<td
									style="text-align:center;background:rgba(230,126,34,0.12);border-bottom:2px solid rgba(255,255,255,0.15);padding:4px 2px;">
									{{{protect_choc_badge}}}</td>
								<td
									style="text-align:center;background:rgba(176,190,197,0.10);border-bottom:2px solid rgba(255,255,255,0.15);padding:4px 2px;">
