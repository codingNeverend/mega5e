				<td align="left">
					<div class="tooltip_h"><span class="talents_rollable"
							value="vehicules_lourds">{{system.talents.vehicules_lourds.label}}</span><span
							class="tooltiptext_h">{{system.talents.vehicules_lourds.description}}</span></div>
				</td>
				<td>{{#if system.verouille}}{{#ifequal system.talents.vehicules_lourds.value 99}}X{{else}}<input
						disabled="disabled" class="comb" type="text" name="system.talents.vehicules_lourds.value"
						value="{{system.talents.vehicules_lourds.value}}"
						data-dtype="Number" />{{/ifequal}}{{else}}<input class="comb" type="text"
						name="system.talents.vehicules_lourds.value" value="{{system.talents.vehicules_lourds.value}}"
						data-dtype="Number" />{{/if}}</td>
				<td align="left">
					<div class="tooltip_h"><span class="talents_rollable"
							value="marge">{{system.talents.marge.label}}</span><span
							class="tooltiptext_h">{{system.talents.marge.description}}</span></div>
				</td>
				<td>{{#if system.verouille}}{{#ifequal system.talents.marge.value 99}}X{{else}}<input
						disabled="disabled" class="comb" type="text" name="system.talents.marge.value"
						value="{{system.talents.marge.value}}" data-dtype="Number" />{{/ifequal}}{{else}}<input
						class="comb" type="text" name="system.talents.marge.value"
						value="{{system.talents.marge.value}}" data-dtype="Number" />{{/if}}</td>
			</tr>
			{{/unless}}
		</table>
		{{/unless}}
	</div>

	</div>
	</div>
	</section>

	</div>

	{{!-- Invisible trigger zone for side tabs --}}
	<div class="side-trigger-zone"></div>

	{{!-- Side Tab Navigation - outside the main content --}}
	<nav class="side-tabs" data-group="primary">
		{{#unless system.reduit}}<a class="side-tab-item" data-tab="description" title="DESCRIPTION">
			<i class="fas fa-user"></i>
		</a>{{/unless}}
		<a class="side-tab-item" data-tab="attributes"
			title="{{#if system.reduit}}ATTRIBUTS & NOTES{{else}}ATTRIBUTS{{/if}}">
			<i class="fas fa-chart-bar"></i>
		</a>
		<a class="side-tab-item" data-tab="combat" title="COMBAT">
			<i class="fas fa-sword"></i>
		</a>
		<a class="side-tab-item" data-tab="items" title="INVENTAIRE">
			<i class="fas fa-backpack"></i>
		</a>
		{{#if GM}}<a class="side-tab-item" data-tab="MJ" title="MJ">
			<i class="fas fa-eye"></i>
		</a>{{/if}}
	</nav>
</form>