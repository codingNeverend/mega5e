			{{!-- Combat Tab --}}
			<div class="tab attributes" data-group="primary" data-tab="combat">
				<div class="bandeau_combat">
					<div style="margin-left:2px;">
						<table class="equipement" {{#if system.reduit}}style="width:430px" {{else}}style="width:450px"
							{{/if}}>
							<thead style="border:none;">
								{{#unless system.reduit}}
								<th align="center" colspan="9">
									<div class="score-breakdown-row"
										style="background:rgba(0,0,0,0.55);border-radius:10px;padding:10px 16px;border:1px solid rgba(220,60,60,0.3);display:flex;align-items:center;flex-wrap:wrap;gap:10px;justify-content:center;">
										<span
											style="display:inline-flex;align-items:center;gap:6px;background:rgba(220,60,60,0.18);border:1.5px solid rgba(220,60,60,0.55);border-radius:20px;padding:4px 14px;">
											<i class="fas fa-fist-raised" style="color:#e08080;font-size:0.9em;"></i>
											<span style="color:#f5a0a0;font-size:0.75em;font-weight:600;">Base
												COMBAT</span>
											<input class="comb" type="text" name="system.domaines.combat.value"
												value="{{system.domaines.combat.value}}" data-dtype="Number"
												style="background:transparent;border:none;color:#f5a0a0;font-weight:bold;font-size:1.12em;width:36px;text-align:center;">
											<span style="color:#a0f0a0;font-size:0.8em;">Rg</span>
										</span>
										<span style="color:#e05050;font-size:1.1em;font-weight:bold;">+</span>
										{{#if system.combat_modif.value}}
										<span
											style="display:inline-flex;align-items:center;gap:5px;background:rgba(220,50,50,0.22);border:1.5px solid rgba(220,80,80,0.75);border-radius:20px;padding:4px 14px;">
											<i class="fas fa-sliders" style="color:#ff8888;font-size:0.85em;"></i>
											<span
												style="color:#ff8888;font-size:0.75em;font-weight:600;">Bonus/Malus</span>
											<input class="comb bonus_combat" type="text"
												name="system.combat_modif.value" value="{{system.combat_modif.value}}"
												data-dtype="Number"
												style="background:transparent;border:none;color:#ff8888;font-weight:bold;font-size:1.08em;width:36px;text-align:center;">
										</span>
										{{else}}
										<span
											style="display:inline-flex;align-items:center;gap:5px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);border-radius:20px;padding:4px 14px;">
											<i class="fas fa-sliders" style="color:#888;font-size:0.85em;"></i>
											<span
												style="color:#aaa;font-size:0.75em;font-weight:600;">Bonus/Malus</span>
											<input class="comb bonus_combat" type="text"
												name="system.combat_modif.value" value="{{system.combat_modif.value}}"
												data-dtype="Number"
												style="background:transparent;border:none;color:#ccc;font-weight:bold;font-size:1.08em;width:36px;text-align:center;">
										</span>
										{{/if}}
										<span style="color:#e05050;font-size:1.2em;font-weight:bold;">=</span>
										<span
											style="display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#8b1a1aee,#5e0f0fcc);color:#fcd8d8;border-radius:20px;padding:6px 22px;font-weight:bold;font-size:1.2em;box-shadow:0 3px 12px rgba(0,0,0,0.6);border:1.5px solid rgba(220,80,80,0.6);">
											<i class="fas fa-trophy" style="color:#e08080;font-size:0.9em;"></i>
											<span style="font-size:0.72em;opacity:0.85;">Total COMBAT</span>
											<span>{{add system.domaines.combat.value system.combat_modif.value}} <span
													style="font-size:0.75em;opacity:0.8;">Rg</span></span>
										</span>
									</div>
								</th>
							</thead>{{/unless}}
							{{#if system.reduit}}<thead style="border:none;">
								<th align="center" colspan="9">COMBAT <i class="fas fa-plus-circle"></i>{{#if
									system.combat_modif.value}}<input class="comb bonus_combat"
										style="background-color: red;" type="text" name="system.combat_modif.value"
										value="{{system.combat_modif.value}}" data-dtype="Number">{{else}}<input
										class="comb" type="text" name="system.combat_modif.value"
										value="{{system.combat_modif.value}}" data-dtype="Number">{{/if}} Rg</th>
							</thead>{{/if}}
							<td colspan="4" style="text-align:center">
								<!-- ici david -->
								{{#unless system.reduit}}<span class="combat_rollable"
									data-type="{{system.derives.initiative.label}}"
									value="{{system.derives.initiative.value}}"><b>Init
									</b></span>{{system.derives.initiative.jet}}<span> <i
										class="fas fa-plus-circle"></i>{{#if system.bonus_initiative.value}}<input
										class="comb" type="text" name="system.bonus_initiative.value"
										style="background-color: red;" value="{{system.bonus_initiative.value}}"
										data-dtype="Number">{{else}}<input class="comb" type="text"
										name="system.bonus_initiative.value" value="{{system.bonus_initiative.value}}"
										data-dtype="Number">{{/if}}</span>{{/unless}}
								{{#if system.reduit}}<span class="combat_rollable"
									data-type="{{system.derives.initiative.label}}"
									value="{{system.derives.initiative.value}}"><b>Init </b></span><input class="comb"
									type="text" name="system.derives.initiative.d1"
									value="{{system.derives.initiative.d1}}" data-dtype="Number">.<input class="comb"
									type="text" name="system.derives.initiative.d2"
									value="{{system.derives.initiative.d2}}" data-dtype="Number"><span> <i
										class="fas fa-plus-circle"></i>{{#if system.bonus_initiative.value}}<input
										class="comb" type="text" name="system.bonus_initiative.value"
										style="background-color: red;" value="{{system.bonus_initiative.value}}"
										data-dtype="Number">{{else}}<input class="comb" type="text"
										name="system.bonus_initiative.value" value="{{system.bonus_initiative.value}}"
										data-dtype="Number">{{/if}}</span>{{/if}}
							</td>
							<td colspan="5">
								{{#unless system.reduit}}<span class="combat_rollable"
									data-type="{{system.derives.esquive.label}}"
									value="{{system.derives.esquive.value}}"><b>Esquive
									</b></span>{{system.derives.esquive.jet}}<span> <i
										class="fas fa-plus-circle"></i>{{#if system.bonus_esquive.value}}<input
										class="comb" type="text" name="system.bonus_esquive.value"
										style="background-color: red;" value="{{system.bonus_esquive.value}}"
										data-dtype="Number">{{else}}<input class="comb" type="text"
										name="system.bonus_esquive.value" value="{{system.bonus_esquive.value}}"
										data-dtype="Number">{{/if}}</span>{{/unless}}
								{{#if system.reduit}}<span class="combat_rollable"
									data-type="{{system.derives.esquive.label}}"
									value="{{system.derives.esquive.value}}"><b>Esquive </b></span><input class="comb"
									type="text" name="system.derives.esquive.d1.value"
									value="{{system.derives.esquive.d1.value}}" data-dtype="Number">.<input class="comb"
									type="text" name="system.derives.esquive.d2.value"
									value="{{system.derives.esquive.d2.value}}" data-dtype="Number">.<input class="comb"
									type="text" name="system.derives.esquive.d3.value"
									value="{{system.derives.esquive.d3.value}}" data-dtype="Number"><span> <i
										class="fas fa-plus-circle"></i>{{#if system.bonus_esquive.value}}<input
										class="comb" type="text" name="system.bonus_esquive.value"
										style="background-color: red;" value="{{system.bonus_esquive.value}}"
										data-dtype="Number">{{else}}<input class="comb" type="text"
										name="system.bonus_esquive.value" value="{{system.bonus_esquive.value}}"
										data-dtype="Number">{{/if}}</span>{{/if}}
							</td>
							<tr
								style="background:linear-gradient(90deg,rgba(15,30,50,0.95),rgba(20,45,70,0.95));border-bottom:2px solid rgba(91,168,212,0.4);">
								<td style="width:14px;"></td>
								<td
									style="width:145px;max-width:145px;padding:6px 8px;color:#c0dff0;font-size:0.82em;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;white-space:nowrap;">
									<i class="fas fa-sword" style="margin-right:5px;color:#7ec8f0;"></i>Techniques
								</td>
								<td
									style="text-align:center;padding:6px 4px;color:#f0e68c;font-size:0.8em;font-weight:700;letter-spacing:0.06em;">
									<i class="fas fa-hashtag" style="font-size:0.8em;"></i> Score
								</td>
								<td
									style="text-align:center;padding:6px 4px;color:#90ee90;font-size:0.8em;font-weight:700;letter-spacing:0.06em;">
									<i class="fas fa-shield-halved" style="font-size:0.8em;"></i> DEF
								</td>
								<td
									style="text-align:center;padding:6px 3px;color:#b0c8e0;font-size:0.8em;font-weight:700;">
									0<span style="font-size:0.75em;opacity:0.8;">Av</span></td>
								<td
									style="text-align:center;padding:6px 3px;color:#90d8ff;font-size:0.8em;font-weight:700;">
									1<span style="font-size:0.75em;opacity:0.8;">Av</span></td>
								<td
									style="text-align:center;padding:6px 3px;color:#70c8f0;font-size:0.8em;font-weight:700;">
									2<span style="font-size:0.75em;opacity:0.8;">Av</span></td>
								<td
									style="text-align:center;padding:6px 3px;color:#50b8e0;font-size:0.8em;font-weight:700;">
									3<span style="font-size:0.75em;opacity:0.8;">Av</span></td>
								<td
									style="text-align:center;padding:6px 3px;color:#30a8d0;font-size:0.8em;font-weight:700;">
									4+<span style="font-size:0.75em;opacity:0.8;">Av</span></td>
							</tr>

							<tr style="background:rgba(205,127,50,0.08);border-left:3px solid rgba(205,127,50,0.6);">
								<td rowspan="2" class="rotation180" width="14px"
									style="background:rgba(205,127,50,0.22);color:#e8b87a;font-size:0.72em;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">
									Mains nues</td>
								<td align="left"><span label="Charge" class="clic_mainsnues" value="charge"><span
