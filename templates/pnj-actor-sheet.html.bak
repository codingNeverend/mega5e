<form class="{{cssClass}}" autocomplete="off">
	{{!-- Sheet Header --}}
	<header class="sheet-header">
		<div class="header-fields">
			<div class="hf-flex">
				{{!-- Portrait --}}
				<div class="hf-portrait">
					<span class="actor-view" value="{{actor.img}}">
						<img src="{{actor.img}}" data-edit="img" title="{{actor.name}}"
							class="img hf-portrait-img{{#if system.combat_modif.value}} hf-combat{{/if}}" />
					</span>
				</div>
				{{!-- Identité : Nom + type --}}
				<div class="hf-identity">
					<div class="hf-name">
						<span class="charname">
							<input {{#if system.verouille}}disabled="disabled" {{/if}} name="name" type="text"
								value="{{actor.name}}" placeholder="Nom" />
						</span>
					</div>
					<div class="hf-meta">
						<span class="hf-meta-field hf-meta-type">
							<i class="fas fa-user hf-meta-icon"></i>
							<span class="reduit" data-type="reduction" value="{{system.reduit}}">
								{{#if system.reduit}}<b>COMPARSE / FIGURANT</b>{{else}}<b>ACTEUR</b>{{/if}}
							</span>
						</span>
					</div>
				</div>
				{{!-- Ressources : VIE et MÊLÉE --}}
				<div class="hf-resources">
					<div class="modern-health-triangle" title="Points de Vie">
						<div class="triangle-icon health-icon">
							<i class="fas fa-plus-circle"
								style="color: {{#ifinferior system.health.value 5}}#e74c3c{{else}}#27ae60{{/ifinferior}};"></i>
						</div>
						<div class="resource-values">
							<input type="text" class="modern-resource-input health-current" name="system.health.value"
								{{#if GM}}value="{{system.health.value}}" {{else}}value="?" {{/if}} data-dtype="Number"
								{{#ifinferior system.health.value 5}}style="color: #e74c3c; font-weight: bold;"
								{{/ifinferior}} />
							<span class="resource-separator">/</span>
							<input class="modern-resource-input health-max" {{#if system.verouille}}disabled="disabled"
								{{/if}} type="text" name="system.health.max" {{#if GM}}value="{{system.health.max}}"
								{{else}}value="?" {{/if}} data-dtype="Number" />
						</div>
						<div class="resource-label">VIE</div>
					</div>
					<div class="modern-melee-triangle" title="Points de Mêlée">
						<div class="triangle-icon melee-icon">
							<i class="fas fa-sword"
								style="color: {{#ifinferior system.power.value 5}}#e74c3c{{else}}#3498db{{/ifinferior}};"></i>
						</div>
						<div class="resource-values">
							<input class="modern-resource-input melee-current" type="text" name="system.power.value"
								value="{{system.power.value}}" data-dtype="Number" {{#ifinferior system.power.value
								5}}style="color: #e74c3c; font-weight: bold;" {{/ifinferior}} />
							<span class="resource-separator">/</span>
							<input type="text" name="system.power.max" {{#if system.verouille}}disabled="disabled"
								{{/if}} class="modern-resource-input melee-max" value="{{system.power.max}}"
								data-dtype="Number" />
						</div>
						<div class="resource-label">MÊLÉE</div>
					</div>
				</div>
			</div>
		</div>
	</header>

	{{!-- Main Content Area with Side Navigation --}}
	<div class="main-content">
		{{!-- Sheet Body --}}
		<section class="sheet-body">

			{{!-- Biography Tab --}}

			<div style="text-align: left;width:96%; margin: 0 auto;" class="tab biography" data-group="primary"
				data-tab="description">
				<div class="biography-tab-frame">
					{{editor enrichedBiography_actor target="system.biography" button=true editable=editable
					height="5px"}}
				</div>
			</div>

			{{!-- Owned Items Tab --}}
			<div class="tab items" data-group="primary" data-tab="items" style="margin:10px; padding: 0 5px;">

				<h3>🎒 Inventaire</h3>

				{{#if actor.objet}}
				<div class="weapon-feature-card">
					<h4 class="feature-title collapsible-header">
						<i class="fas fa-cube"></i> Objets ({{actor.objet.length}})
						<i class="fas fa-chevron-down collapse-icon"></i>
					</h4>
					<div class="card-content">
						<div class="inventory-grid">
							{{#each actor.objet as |item id|}}
							<div class="inventory-item-card">
								<div class="inventory-item-image">
									<img id="{{item._id}}" class="item-name item-edit items_rollable" src="{{item.img}}"
										title="{{item.name}}" />
									{{#ifsuperior item.system.quantity 1}}<span
										class="item-quantity-badge">{{item.system.quantity}}</span>{{/ifsuperior}}
									<span class="item-delete item-trash-badge"
										style="position:absolute; bottom:-2px; left:-2px; z-index:2; cursor:pointer;">
										<i class="fas fa-trash-alt" style="font-size:13px; color:#c0392b;"></i>
									</span>
								</div>
								<div class="inventory-item-name">{{item.name}}</div>
							</div>
							{{/each}}
						</div>
					</div>
				</div>
				{{/if}}

				<div class="inventory-sections">
					<div class="inventory-section-weapons">
						<h4 class="section-title"><i class="fas fa-crossed-swords"></i> Armement</h4>

						{{#if actor.tirs}}
						<div class="weapon-feature-card collapsed">
							<h4 class="feature-title collapsible-header">
								<i class="fas fa-crosshairs"></i> Armes de Tir ({{actor.tirs.length}})
								<i class="fas fa-chevron-down collapse-icon"></i>
							</h4>
							<div class="card-content">
								<div class="inventory-grid">
									{{#each actor.tirs as |item id|}}
									<div class="inventory-item-card">
										<div class="inventory-item-image">
											<img id="{{item._id}}" class="item-name item-edit items_rollable"
												src="{{item.img}}" title="{{item.name}}" />
											{{#ifsuperior item.system.quantity 1}}<span
												class="item-quantity-badge">{{item.system.quantity}}</span>{{/ifsuperior}}
											<span class="item-charge-badge"><i
													class="fas fa-bolt"></i>{{item.system.charge}}</span>
											<span class="item-delete item-trash-badge"
												style="position:absolute; bottom:-2px; left:-2px; z-index:2; cursor:pointer;">
												<i class="fas fa-trash-alt" style="font-size:13px; color:#c0392b;"></i>
											</span>
											<span
												class="item-equipe-toggle{{#if item.system.equipe}} equipe-active{{/if}}"
												data-item-id="{{item._id}}" data-item-type="{{item.type}}"
												title="{{#if item.system.equipe}}Retirer de l'onglet combat{{else}}Ajouter à l'onglet combat{{/if}}">
												<i class="fa-solid fa-hand-fist"></i>
											</span>
										</div>
										<div class="inventory-item-name">{{item.name}}</div>
									</div>
									{{/each}}
								</div>
							</div>
						</div>
						{{/if}}

						{{#if actor.courtes}}
						<div class="weapon-feature-card collapsed">
							<h4 class="feature-title collapsible-header">
								<i class="fas fa-cut"></i> Armes Courtes ({{actor.courtes.length}})
								<i class="fas fa-chevron-down collapse-icon"></i>
							</h4>
							<div class="card-content">
								<div class="inventory-grid">
									{{#each actor.courtes as |item id|}}
									<div class="inventory-item-card">
										<div class="inventory-item-image">
											<img id="{{item._id}}" class="item-name item-edit items_rollable"
												src="{{item.img}}" title="{{item.name}}" />
											{{#ifsuperior item.system.quantity 1}}<span
												class="item-quantity-badge">{{item.system.quantity}}</span>{{/ifsuperior}}
											<span class="item-delete item-trash-badge"
												style="position:absolute; bottom:-2px; left:-2px; z-index:2; cursor:pointer;">
												<i class="fas fa-trash-alt" style="font-size:13px; color:#c0392b;"></i>
											</span>
											<span
												class="item-equipe-toggle{{#if item.system.equipe}} equipe-active{{/if}}"
												data-item-id="{{item._id}}" data-item-type="{{item.type}}"
												title="{{#if item.system.equipe}}Retirer de l'onglet combat{{else}}Ajouter à l'onglet combat{{/if}}">
												<i class="fa-solid fa-hand-fist"></i>
											</span>
										</div>
										<div class="inventory-item-name">{{item.name}}</div>
									</div>
									{{/each}}
								</div>
							</div>
						</div>
						{{/if}}

						{{#if actor.longues}}
						<div class="weapon-feature-card collapsed">
							<h4 class="feature-title collapsible-header">
								<i class="fas fa-sword"></i> Armes Longues ({{actor.longues.length}})
								<i class="fas fa-chevron-down collapse-icon"></i>
							</h4>
							<div class="card-content">
								<div class="inventory-grid">
									{{#each actor.longues as |item id|}}
									<div class="inventory-item-card">
										<div class="inventory-item-image">
											<img id="{{item._id}}" class="item-name item-edit items_rollable"
												src="{{item.img}}" title="{{item.name}}" />
											{{#ifsuperior item.system.quantity 1}}<span
												class="item-quantity-badge">{{item.system.quantity}}</span>{{/ifsuperior}}
											<span class="item-delete item-trash-badge"
												style="position:absolute; bottom:-2px; left:-2px; z-index:2; cursor:pointer;">
												<i class="fas fa-trash-alt" style="font-size:13px; color:#c0392b;"></i>
											</span>
											<span
												class="item-equipe-toggle{{#if item.system.equipe}} equipe-active{{/if}}"
												data-item-id="{{item._id}}" data-item-type="{{item.type}}"
												title="{{#if item.system.equipe}}Retirer de l'onglet combat{{else}}Ajouter à l'onglet combat{{/if}}">
												<i class="fa-solid fa-hand-fist"></i>
											</span>
										</div>
										<div class="inventory-item-name">{{item.name}}</div>
									</div>
									{{/each}}
								</div>
							</div>
						</div>
						{{/if}}

						{{#if actor.lancer}}
						<div class="weapon-feature-card collapsed">
							<h4 class="feature-title collapsible-header">
								<i class="fas fa-bullseye"></i> Armes de Lancer ({{actor.lancer.length}})
								<i class="fas fa-chevron-down collapse-icon"></i>
							</h4>
							<div class="card-content">
								<div class="inventory-grid">
									{{#each actor.lancer as |item id|}}
									<div class="inventory-item-card">
										<div class="inventory-item-image">
											<img id="{{item._id}}" class="item-name item-edit items_rollable"
												src="{{item.img}}" title="{{item.name}}" />
											{{#ifsuperior item.system.quantity 1}}<span
												class="item-quantity-badge">{{item.system.quantity}}</span>{{/ifsuperior}}
											<span class="item-delete item-trash-badge"
												style="position:absolute; bottom:-2px; left:-2px; z-index:2; cursor:pointer;">
												<i class="fas fa-trash-alt" style="font-size:13px; color:#c0392b;"></i>
											</span>
											<span
												class="item-equipe-toggle{{#if item.system.equipe}} equipe-active{{/if}}"
												data-item-id="{{item._id}}" data-item-type="{{item.type}}"
												title="{{#if item.system.equipe}}Retirer de l'onglet combat{{else}}Ajouter à l'onglet combat{{/if}}">
												<i class="fa-solid fa-hand-fist"></i>
											</span>
										</div>
										<div class="inventory-item-name">{{item.name}}</div>
									</div>
									{{/each}}
								</div>
							</div>
						</div>
						{{/if}}

						{{#if actor.melee}}
						<div class="weapon-feature-card collapsed">
							<h4 class="feature-title collapsible-header">
								<i class="fas fa-fist-raised"></i> Attaques Spéciales ({{actor.melee.length}})
								<i class="fas fa-chevron-down collapse-icon"></i>
							</h4>
							<div class="card-content">
								<div class="inventory-grid">
									{{#each actor.melee as |item id|}}
									<div class="inventory-item-card">
										<div class="inventory-item-image">
											<img id="{{item._id}}" class="item-name item-edit items_rollable"
												src="{{item.img}}" title="{{item.name}}" />
											{{#ifsuperior item.system.quantity 1}}<span
												class="item-quantity-badge">{{item.system.quantity}}</span>{{/ifsuperior}}
											<span class="item-delete item-trash-badge"
												style="position:absolute; bottom:-2px; left:-2px; z-index:2; cursor:pointer;">
												<i class="fas fa-trash-alt" style="font-size:13px; color:#c0392b;"></i>
											</span>
											<span
												class="item-equipe-toggle{{#if item.system.equipe}} equipe-active{{/if}}"
												data-item-id="{{item._id}}" data-item-type="{{item.type}}"
												title="{{#if item.system.equipe}}Retirer de l'onglet combat{{else}}Ajouter à l'onglet combat{{/if}}">
												<i class="fa-solid fa-hand-fist"></i>
											</span>
										</div>
										<div class="inventory-item-name">{{item.name}}</div>
									</div>
									{{/each}}
								</div>
							</div>
						</div>
						{{/if}}
					</div>

					<div class="inventory-section-equipment">
						<h4 class="section-title"><i class="fa-solid fa-hand-fist"></i> Équipement</h4>

						{{#if actor.protections}}
						<div class="weapon-feature-card collapsed">
							<h4 class="feature-title collapsible-header">
								<i class="fas fa-vest"></i> Protections ({{actor.protections.length}})
								<i class="fas fa-chevron-down collapse-icon"></i>
							</h4>
							<div class="card-content">
								<div class="inventory-grid">
									{{#each actor.protections as |item id|}}
									<div class="inventory-item-card">
										<div class="inventory-item-image">
											<img id="{{item._id}}" class="item-name item-edit items_rollable"
												src="{{item.img}}" title="{{item.name}}" />
											{{#ifsuperior item.system.quantity 1}}<span
												class="item-quantity-badge">{{item.system.quantity}}</span>{{/ifsuperior}}
											<span class="item-delete item-trash-badge"
												style="position:absolute; bottom:-2px; left:-2px; z-index:2; cursor:pointer;">
												<i class="fas fa-trash-alt" style="font-size:13px; color:#c0392b;"></i>
											</span>
											<span
												class="item-equipe-toggle{{#if item.system.equipe}} equipe-active{{/if}}"
												data-item-id="{{item._id}}" data-item-type="{{item.type}}"
												title="{{#if item.system.equipe}}Retirer de l'onglet combat{{else}}Ajouter a l'onglet combat (activer){{/if}}">
												<i class="fa-solid fa-shield-halved"></i>
											</span>
										</div>
										<div class="inventory-item-name">{{item.name}}</div>
									</div>
									{{/each}}
								</div>
							</div>
						</div>
						{{/if}}

						{{#if actor.pouvoir}}
						<div class="weapon-feature-card collapsed">
							<h4 class="feature-title collapsible-header">
								<i class="fas fa-magic"></i> Pouvoirs ({{actor.pouvoir.length}})
								<i class="fas fa-chevron-down collapse-icon"></i>
							</h4>
							<div class="card-content">
								<div class="inventory-grid">
									{{#each actor.pouvoir as |item id|}}
									<div class="inventory-item-card">
										<div class="inventory-item-image">
											<img id="{{item._id}}" class="item-name item-edit items_rollable"
												src="{{item.img}}" title="{{item.name}}" />
											{{#ifsuperior item.system.quantity 1}}<span
												class="item-quantity-badge">{{item.system.quantity}}</span>{{/ifsuperior}}
											<span class="item-delete item-trash-badge"
												style="position:absolute; bottom:-2px; left:-2px; z-index:2; cursor:pointer;">
												<i class="fas fa-trash-alt" style="font-size:13px; color:#c0392b;"></i>
											</span>
										</div>
										<div class="inventory-item-name">{{item.name}}</div>
									</div>
									{{/each}}
								</div>
							</div>
						</div>
						{{/if}}
					</div>
				</div>
			</div>

			{{!-- MJ Tab --}}

			<div class="tab" data-group="primary" data-tab="MJ" style="margin:10px; padding: 0 5px;">
				<div>

					<div class="weapon-feature-card advantages-card collapsed">
						<h4 class="feature-title collapsible-header">
							<i class="fas fa-plus-circle"></i> Paramétrer la Charge
							<i class="fas fa-chevron-down collapse-icon"></i>
						</h4>
						<div class="card-content">
							{{#if system.masquer_avantage_charge}}
							<div class="advantages-grid">
								<div class="advantage-column">
									<div class="advantage-header">Av0</div>
									<div class="advantage-field">
										<label>Points de Mêlée</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input advantage-input" type="text"
											name="system.talents_combat.charge.av0"
											value="{{system.talents_combat.charge.av0}}" data-dtype="Number" />
									</div>
									<div class="advantage-field">
										<label>1er Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
											name="system.talents_combat.charge.effet_ac_0_1"
											value="{{system.talents_combat.charge.effet_ac_0_1}}" />
									</div>
									<div class="advantage-field">
										<label>2ème Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
											name="system.talents_combat.charge.effet_ac_0_2"
											value="{{system.talents_combat.charge.effet_ac_0_2}}" />
									</div>
									<div class="advantage-field">
										<label>3ème Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
											name="system.talents_combat.charge.effet_ac_0_3"
											value="{{system.talents_combat.charge.effet_ac_0_3}}" />
									</div>
								</div>
								<div class="advantage-column">
									<div class="advantage-header">Av1</div>
									<div class="advantage-field">
										<label>Points de Mêlée</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input advantage-input" type="text"
											name="system.talents_combat.charge.av1"
											value="{{system.talents_combat.charge.av1}}" data-dtype="Number" />
									</div>
									<div class="advantage-field">
										<label>1er Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
											name="system.talents_combat.charge.effet_ac_1_1"
											value="{{system.talents_combat.charge.effet_ac_1_1}}" />
									</div>
									<div class="advantage-field">
										<label>2ème Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
											name="system.talents_combat.charge.effet_ac_1_2"
											value="{{system.talents_combat.charge.effet_ac_1_2}}" />
									</div>
									<div class="advantage-field">
										<label>3ème Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
											name="system.talents_combat.charge.effet_ac_1_3"
											value="{{system.talents_combat.charge.effet_ac_1_3}}" />
									</div>
								</div>
								<div class="advantage-column">
									<div class="advantage-header">Av2</div>
									<div class="advantage-field">
										<label>Points de Mêlée</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input advantage-input" type="text"
											name="system.talents_combat.charge.av2"
											value="{{system.talents_combat.charge.av2}}" data-dtype="Number" />
									</div>
									<div class="advantage-field">
										<label>1er Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
											name="system.talents_combat.charge.effet_ac_2_1"
											value="{{system.talents_combat.charge.effet_ac_2_1}}" />
									</div>
									<div class="advantage-field">
										<label>2ème Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
											name="system.talents_combat.charge.effet_ac_2_2"
											value="{{system.talents_combat.charge.effet_ac_2_2}}" />
									</div>
									<div class="advantage-field">
										<label>3ème Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
											name="system.talents_combat.charge.effet_ac_2_3"
											value="{{system.talents_combat.charge.effet_ac_2_3}}" />
									</div>
								</div>
								<div class="advantage-column">
									<div class="advantage-header">Av3</div>
									<div class="advantage-field">
										<label>Points de Mêlée</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input advantage-input" type="text"
											name="system.talents_combat.charge.av3"
											value="{{system.talents_combat.charge.av3}}" data-dtype="Number" />
									</div>
									<div class="advantage-field">
										<label>1er Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
											name="system.talents_combat.charge.effet_ac_3_1"
											value="{{system.talents_combat.charge.effet_ac_3_1}}" />
									</div>
									<div class="advantage-field">
										<label>2ème Effet</label>
										<input {{#unless GM}}readonly="readonly" {{/unless}}
											class="modern-input effect-input" type="text"
