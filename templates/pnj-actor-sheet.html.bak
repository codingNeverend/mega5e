		<thead style="border:none;">
			<tr>
				<th colspan="4">CUMUL et DÉFIS</th>
			</tr>
		</thead>
		<tr>
			<td><span class="test"><meter style="width: 200px;" value="{{system.cumul_defi.value}}"
						min="{{system.cumul_defi.min}}" max="{{system.cumul_defi.max}}"></meter></span></td>
			<td width="5%"><input class="comb" type="text" name="system.cumul_defi.value"
					value="{{system.cumul_defi.value}}" data-dtype="Number" /></td>
			<td>/</td>
			<td width="5%"><input class="comb" type="text" name="system.cumul_defi.max"
					value="{{system.cumul_defi.max}}" data-dtype="Number" /></td>
		</tr>
	</table>
	<table class="equipement" style="border:none; width:100%;">
		<tr>
			<td align="center">
				<b>RESISTANCE AU TRANSFERT</b>
			</td>
			<td><input class="comb" type="text" name="system.resistance_transfert"
					value="{{system.resistance_transfert}}" data-dtype="Number" /></td>
		</tr>
	</table>
	</div>
